{
  "name": "orbit-project-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A complete local-first project management workspace with React, Node.js and SQLite.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "server": "node server/index.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.59.0"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "jsdom": "30.1.3"
  }
}
